{
  "name": "characteros",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "desktop:setup": "node node_modules/electron/install.js",
    "desktop:dev": "pnpm desktop:setup && electron desktop/app/main.cjs --dev",
    "desktop:pack": "pnpm desktop:setup && pnpm build && node scripts/prepare-desktop.mjs && electron-builder --projectDir desktop/app --config ../electron-builder.yml --dir",
    "desktop:build": "pnpm desktop:setup && pnpm build && node scripts/prepare-desktop.mjs && electron-builder --projectDir desktop/app --config ../electron-builder.yml --win nsis",
    "start": "next start",
    "lint": "eslint .",
    "h3": "powershell -ExecutionPolicy Bypass -File scripts\\start-h3.ps1",
    "seed": "node scripts/seed-characters.mjs",
    "test": "vitest run",
    "tts": ".venv-tts-native\\Scripts\\python.exe scripts\\kokoro-tts-server.py",
    "tts:setup": "powershell -ExecutionPolicy Bypass -File scripts\\setup-tts.ps1"
  },
  "dependencies": {
    "better-sqlite3": "latest",
    "drizzle-orm": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "latest",
    "typescript": "^6.0.0",
    "vitest": "latest"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  }
}
