{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@characteros/contracts/*": [
        "./packages/contracts/src/*"
      ],
      "@/server/*": [
        "./services/api/src/server/*"
      ],
      "@/components/*": [
        "./apps/web/src/components/*"
      ]
    }
  },
  "include": [
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.tsx",
    "services/api/src/**/*.ts",
    "packages/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
